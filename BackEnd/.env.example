# Copia este archivo a BackEnd/.env y sustituye los valores.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=CAMBIA_ESTA_CLAVE_SECRETA
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Mismo usuario y contraseña que POSTGRES_USER y POSTGRES_PASSWORD del .env raíz.
DATABASE_URL=postgres://nucleo_app:CAMBIA_ESTE_PASSWORD@127.0.0.1:55432/nucleo_db
# Mismo usuario y contraseña que IOT_USER e IOT_PASSWORD del .env raíz (TimescaleDB).
IOT_DATABASE_URL=postgres://nucleo_iot:CAMBIA_ESTE_PASSWORD_IOT@127.0.0.1:55433/nucleo_iot
# 0 = cada petición cierra su conexión. Daphne (ASGI) atiende en varios hilos y con conexiones
# persistentes cada hilo deja la suya abierta hasta agotar max_connections (25 en TimescaleDB).
DB_CONN_MAX_AGE=0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcionales
DJANGO_LANGUAGE_CODE=es
DJANGO_TIME_ZONE=America/Tijuana
DJANGO_LOG_LEVEL=INFO

# Ejemplo de producción (no activar junto con development)
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_TRUST_X_FORWARDED_PROTO=True

# Correo (por defecto se imprime en consola)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Núcleo <alertas@example.com>

# Broker MQTT (Mosquitto con TLS en 8883)
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_USERNAME=nucleo_backend
MQTT_PASSWORD=CAMBIA_ESTE_PASSWORD_MQTT
MQTT_USE_TLS=True
MQTT_CA_CERT=../Mosquitto/certs/ca.crt
MQTT_TOPIC_LECTURAS=nucleo/devices/+/measurements
MQTT_PUBLICAR_CONFIG=False

# Servicio de IA para reportes. "local" redacta con plantillas a partir de las cifras;
# vacío deja los reportes sin generar (503).
IA_PROVEEDOR=local
# IA_API_KEY=
# IA_MODELO=
# Nico AI con IA local (Ollama) por el ESP32 de cada dispositivo. Vacía = puente apagado: el agente
# usa solo respuestas predefinidas y no depende de ningún ESP. Genera una con: openssl rand -hex 24
IA_PUENTE_CLAVE=
IA_MODELO_LOCAL=qwen2.5:1.5b
# Ollama visto desde el backend (modo ligero del puente: el servidor ejecuta la IA).
IA_OLLAMA_URL=http://127.0.0.1:11434
# Segundos que se espera a la IA antes de responder con la predefinida
IA_ESPERA_SEGUNDOS=20
# Nico AI según la memoria libre del servidor (MB): por debajo de ALTA no usa la IA y limita las
# preguntas por usuario por minuto; por debajo de CRITICA limita más.
# NUCLEO_AGENTE_RAM_ALTA_MB=1200
# NUCLEO_AGENTE_RAM_CRITICA_MB=500
# NUCLEO_AGENTE_LIMITE_NORMAL=30
# NUCLEO_AGENTE_LIMITE_ALTA=10
# NUCLEO_AGENTE_LIMITE_CRITICA=4

# Canal en vivo (WebSocket). Vacío usa la memoria del proceso.
# REDIS_URL=redis://:REDIS_PASSWORD@127.0.0.1:56379/0
NUCLEO_TOKEN_DIAS_SIN_USO=7
