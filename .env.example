# PostgreSQL 17 para Django
# Copia este archivo a .env y cambia las contraseñas.
POSTGRES_DB=nucleo_db
POSTGRES_USER=nucleo_app
POSTGRES_PASSWORD=CAMBIA_ESTE_PASSWORD
POSTGRES_PORT=55432

# TimescaleDB para la telemetría de IoT
IOT_DB=nucleo_iot
IOT_USER=nucleo_iot
IOT_PASSWORD=CAMBIA_ESTE_PASSWORD_IOT
IOT_PORT=55433

# Broker MQTT (Mosquitto con TLS en 8883). Después de definirlas: bash Mosquitto/preparar.sh
MQTT_PORT=8883
# Interfaz donde escucha el broker: 127.0.0.1 solo local; 0.0.0.0 para conectar el ESP32 por la red.
MQTT_BIND=127.0.0.1
# Nombres o IP extra del certificado del servidor, separados por comas (p. ej. 192.168.1.10).
MQTT_SERVER_NAMES=
MQTT_BACKEND_PASSWORD=CAMBIA_ESTE_PASSWORD_MQTT_BACKEND
# Contraseña del dispositivo de demostración NUC-001; los demás se crean con Mosquitto/dispositivo.sh
MQTT_DEVICE_PASSWORD=CAMBIA_ESTE_PASSWORD_MQTT_DISPOSITIVO

# Redis: canal en vivo (WebSocket) entre procesos del backend
REDIS_PASSWORD=CAMBIA_ESTE_PASSWORD_REDIS
REDIS_PORT=56379

# Usuarios de producción sin superusuario (bash Database/crear-roles.sh)
BACKEND_DB_PASSWORD=CAMBIA_ESTE_PASSWORD_BACKEND
BACKEND_IOT_DB_PASSWORD=CAMBIA_ESTE_PASSWORD_BACKEND_IOT
