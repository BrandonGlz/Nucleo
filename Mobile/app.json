{
  "expo": {
    "name": "Núcleo",
    "slug": "-nucleo-mobile",
    "owner": "nucleo-expo",
    "version": "0.1.5",
    "orientation": "portrait",
    "scheme": "nucleo",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icono.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nucleo.mobile"
    },
    "android": {
      "package": "com.nucleo.mobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono-adaptativo.png",
        "monochromeImage": "./assets/icono-monocromo.png",
        "backgroundColor": "#1A1C1C"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icono-monocromo.png",
          "color": "#2BC47A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9dfd5c1a-95a1-490b-86c3-6079efd52269"
      }
    }
  }
}
