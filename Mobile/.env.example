# URL base de la API Django, incluyendo el prefijo de versión.
# Emulador Android: http://10.0.2.2:8000/api/v1
# Simulador iOS: http://localhost:8000/api/v1
# Teléfono físico: http://IP_LOCAL_DE_LA_COMPUTADORA:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# true: la app responde con los datos simulados de src/services/mock y no llama a la API.
EXPO_PUBLIC_USE_MOCKS=true
# Fuerza un estado de pantalla para revisar el diseño: cargando, vacio, error o sinConexion.
# Vacío para el funcionamiento normal.
EXPO_PUBLIC_MOCK_ESTADO=
