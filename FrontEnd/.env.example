# URL base de la API Django, incluyendo el prefijo de versión.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true: la web funciona con datos simulados (src/services/mock) sin backend.
VITE_USE_MOCKS=true
# Rol de la sesión simulada: ADMIN, SUPER o ANALISTA.
VITE_MOCK_ROL=SUPER

# Con la API real: contraseña de las cuentas de `manage.py sembrar_demo`. Si tiene valor, la
# pantalla de acceso muestra esas cuentas para entrar con un clic. Vacía, no se muestran.
VITE_DEMO_PASSWORD=
