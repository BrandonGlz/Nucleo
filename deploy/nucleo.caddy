# Núcleo: Cloudflare Tunnel (bynucleo.com, app., nicoai. y dispositivos.) -> Caddy 127.0.0.1:8081
# __RAIZ__ lo reemplaza deploy/instalar.sh por la carpeta del proyecto.
# /media no se publica: los PDF de reportes se descargan por la API con token.
http://:8081 {
	bind 127.0.0.1
	encode zstd gzip

	# Bitácora de accesos en el journal de caddy (journalctl -u caddy), en JSON con la IP real del visitante
	log {
		output stderr
		format json
	}

	# Encabezados de seguridad en todo el sitio (revisados con OWASP ZAP). La API de Django pone
	# además los suyos.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Visitas por http:// (Cloudflare lo avisa en X-Forwarded-Proto) -> https://
	@http header X-Forwarded-Proto http
	redir @http https://{host}{uri} permanent

	# www.bynucleo.com -> bynucleo.com
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# app.bynucleo.com: solo la descarga del APK. La raíz (index.html, lo escribe compilar_apk.sh) lleva a
	# nucleo-<versión>.apk; el enlace fijo anterior /nucleo.apk lleva a la raíz.
	@app host app.bynucleo.com
	handle @app {
		redir /nucleo.apk / 302
		root * __RAIZ__/deploy/descargas
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition attachment
		header Cache-Control no-cache
		file_server
	}

	# La descarga anterior (bynucleo.com/app/...) se mudó a app.bynucleo.com
	@app_anterior path_regexp app_anterior ^/app/(.*)$
	redir @app_anterior https://app.bynucleo.com/{re.app_anterior.1} permanent

	# dispositivos.bynucleo.com es de los ESP32: /mqtt lo toma cloudflared y aquí solo quedan el
	# respaldo HTTPS de Nico y la hora (health). Lo demás lleva a la web.
	@dispositivos {
		host dispositivos.bynucleo.com
		not path /api/v1/puente/* /api/v1/health/
	}
	redir @dispositivos https://bynucleo.com permanent

	# Latido de las páginas con sesión abierta (cada minuto): solo queda en la bitácora para contar conectados
	handle /latido {
		header Cache-Control no-store
		respond 204
	}

	# API, canal en vivo (WebSocket) y admin de Django (daphne)
	@django path /api/* /ws/* /admin/*
	handle @django {
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Forwarded-Proto https
		}
	}

	handle_path /static/* {
		root * __RAIZ__/BackEnd/staticfiles
		file_server
	}

	# Web de React (vite build). CSP: scripts solo propios (lo que importa contra XSS); los estilos
	# en línea hacen falta para las gráficas SVG y la impresión de reportes. El canal en vivo va
	# por wss:// al mismo host. Cloudflare inyecta su script de Web Analytics (static.
	# cloudflareinsights.com, que reporta a cloudflareinsights.com): se permite solo ese origen.
	# Probada en Chrome, Firefox y Brave con todas las páginas.
	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://{host} https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			X-Frame-Options DENY
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-write=(self)"
		}
		# index.html siempre se revisa (trae los nombres nuevos de los archivos tras un deploy);
		# los archivos de /assets llevan hash en el nombre y se pueden guardar.
		@pagina not path /assets/*
		header @pagina Cache-Control no-cache
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		root * __RAIZ__/FrontEnd/dist
		try_files {path} /index.html
		file_server
	}
}
