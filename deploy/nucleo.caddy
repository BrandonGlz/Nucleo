# Núcleo: Cloudflare Tunnel (bynucleo.com, app. y dispositivos.) -> Caddy 127.0.0.1:8081
# __RAIZ__ lo reemplaza deploy/instalar.sh por la carpeta del proyecto.
# /media no se publica: los PDF de reportes se descargan por la API con token.
http://:8081 {
	bind 127.0.0.1
	encode zstd gzip

	# Bitácora de accesos en el journal de caddy (journalctl -u caddy), en JSON con la IP real del visitante
	log {
		output stderr
		format json
	}

	# Visitas por http:// (Cloudflare lo avisa en X-Forwarded-Proto) -> https://
	@http header X-Forwarded-Proto http
	redir @http https://{host}{uri} permanent

	# www.bynucleo.com -> bynucleo.com
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# app.bynucleo.com: solo la descarga del APK (la raíz lleva al archivo)
	@app host app.bynucleo.com
	handle @app {
		redir / /nucleo.apk
		root * __RAIZ__/deploy/descargas
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition attachment
		header Cache-Control no-cache
		file_server
	}

	# La descarga anterior (bynucleo.com/app/...) se mudó a app.bynucleo.com
	@app_anterior path_regexp app_anterior ^/app/(.*)$
	redir @app_anterior https://app.bynucleo.com/{re.app_anterior.1} permanent

	# dispositivos.bynucleo.com es de los ESP32: /mqtt lo toma cloudflared y aquí solo quedan el
	# respaldo HTTPS de Nico y la hora (health). Lo demás lleva a la web.
	@dispositivos {
		host dispositivos.bynucleo.com
		not path /api/v1/puente/* /api/v1/health/
	}
	redir @dispositivos https://bynucleo.com permanent

	# Latido de las páginas con sesión abierta (cada minuto): solo queda en la bitácora para contar conectados
	handle /latido {
		header Cache-Control no-store
		respond 204
	}

	# API, canal en vivo (WebSocket) y admin de Django (daphne)
	@django path /api/* /ws/* /admin/*
	handle @django {
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Forwarded-Proto https
		}
	}

	handle_path /static/* {
		root * __RAIZ__/BackEnd/staticfiles
		file_server
	}

	# Web de React (vite build)
	handle {
		root * __RAIZ__/FrontEnd/dist
		try_files {path} /index.html
		file_server
	}
}
