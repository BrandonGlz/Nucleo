# Núcleo: Cloudflare Tunnel (https://bynucleo.com) y el Funnel del contenedor nucleo_tailscale
# (https://nucleo.<tailnet>.ts.net, que usan los ESP32) -> Caddy 127.0.0.1:8081
# __RAIZ__ lo reemplaza deploy/instalar.sh por la carpeta del proyecto.
# /media no se publica: los PDF de reportes se descargan por la API con token.
http://:8081 {
	bind 127.0.0.1
	encode zstd gzip

	# Bitácora de accesos en el journal de caddy (journalctl -u caddy), en JSON con la IP real del visitante
	log {
		output stderr
		format json
	}

	# Visitas por http:// (Cloudflare lo avisa en X-Forwarded-Proto) -> https://
	@http header X-Forwarded-Proto http
	redir @http https://{host}{uri} permanent

	# www.bynucleo.com -> bynucleo.com
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# La dirección anterior (Tailscale, *.ts.net) lleva la web al dominio. Se quedan ahí la API y el
	# canal en vivo (apps 0.1.7 y el respaldo HTTPS de los ESP32) y la descarga del APK.
	@anterior {
		header_regexp anterior Host \.ts\.net$
		not path /api/* /ws/* /app/* /latido
	}
	redir @anterior https://bynucleo.com{uri} permanent

	# Latido de las páginas con sesión abierta (cada minuto): solo queda en la bitácora para contar conectados
	handle /latido {
		header Cache-Control no-store
		respond 204
	}

	# API, canal en vivo (WebSocket) y admin de Django (daphne)
	@django path /api/* /ws/* /admin/*
	handle @django {
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Forwarded-Proto https
		}
	}

	# APK de la app móvil (fuera de git): se copia a __RAIZ__/deploy/descargas; ver deploy/README.md
	handle_path /app/* {
		root * __RAIZ__/deploy/descargas
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition attachment
		header Cache-Control no-cache
		file_server
	}

	handle_path /static/* {
		root * __RAIZ__/BackEnd/staticfiles
		file_server
	}

	# Web de React (vite build)
	handle {
		root * __RAIZ__/FrontEnd/dist
		try_files {path} /index.html
		file_server
	}
}
