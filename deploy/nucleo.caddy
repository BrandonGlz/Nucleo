# Núcleo: Funnel del contenedor nucleo_tailscale (https://nucleo.<tailnet>.ts.net) -> Caddy 127.0.0.1:8081
# __RAIZ__ lo reemplaza deploy/instalar.sh por la carpeta del proyecto.
# /media no se publica: los PDF de reportes se descargan por la API con token.
http://:8081 {
	bind 127.0.0.1
	encode zstd gzip

	# Bitácora de accesos en el journal de caddy (journalctl -u caddy), en JSON con la IP real del visitante
	log {
		output stderr
		format json
	}

	# Latido de las páginas con sesión abierta (cada minuto): solo queda en la bitácora para contar conectados
	handle /latido {
		header Cache-Control no-store
		respond 204
	}

	# API, canal en vivo (WebSocket) y admin de Django (daphne)
	@django path /api/* /ws/* /admin/*
	handle @django {
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Forwarded-Proto https
		}
	}

	# IA local (Ollama) para el ESP32 puente de Nico AI: solo con la clave del puente
	# (__PUENTE_CLAVE__ la pone deploy/instalar.sh desde IA_PUENTE_CLAVE de BackEnd/.env).
	handle_path /puente-ia/* {
		@sin_clave not header X-Puente-Clave "__PUENTE_CLAVE__"
		respond @sin_clave 403
		reverse_proxy 127.0.0.1:11434
	}

	# APK de la app móvil (fuera de git): se copia a __RAIZ__/deploy/descargas; ver deploy/README.md
	handle_path /app/* {
		root * __RAIZ__/deploy/descargas
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition attachment
		header Cache-Control no-cache
		file_server
	}

	handle_path /static/* {
		root * __RAIZ__/BackEnd/staticfiles
		file_server
	}

	# Web de React (vite build)
	handle {
		root * __RAIZ__/FrontEnd/dist
		try_files {path} /index.html
		file_server
	}
}
