#!/usr/bin/env python3
"""Manda un correo a la cuenta de avisos con la configuración SMTP del vigilante. Uso: mantenimiento-asus-correo ASUNTO CUERPO"""
import smtplib, ssl, sys
from email.message import EmailMessage
from email.utils import formatdate, make_msgid
c = {}
for l in open('/home/adminasus/.config/vigia-smtp-nucleo.env', encoding='utf-8'):
    if '=' in l and not l.lstrip().startswith('#'):
        k, v = l.split('=', 1); c[k.strip()] = v.strip().strip('"\'')
u, p = c['EMAIL_HOST_USER'], c['EMAIL_HOST_PASSWORD']
m = EmailMessage()
m['Subject'], m['From'], m['To'] = sys.argv[1], f'Avisos servidor <{u}>', u
m['Date'], m['Message-ID'] = formatdate(localtime=True), make_msgid()
m.set_content(sys.argv[2] + '\n\n— mantenimiento-asus (corrido a mano)')
h, pt = c.get('EMAIL_HOST', 'smtp.gmail.com'), int(c.get('EMAIL_PORT') or 587)
with smtplib.SMTP(h, pt, timeout=30) as s:
    s.starttls(context=ssl.create_default_context()); s.login(u, p); s.send_message(m)
