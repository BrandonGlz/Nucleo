[Unit]
Description=Mantenimiento de asus: tras su reinicio, revisa que todo levante y manda el correo
After=network-online.target docker.service tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mantenimiento-asus --arranque
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
