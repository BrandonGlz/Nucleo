[Unit]
Description=Núcleo - API y canal en vivo (daphne)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=__USUARIO__
Group=__USUARIO__
WorkingDirectory=__RAIZ__/BackEnd
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=__RAIZ__/BackEnd/.venv/bin/daphne -b 127.0.0.1 -p 8001 --proxy-headers config.asgi:application
UMask=0022
Restart=on-failure
RestartSec=5
MemoryMax=500M

[Install]
WantedBy=multi-user.target
