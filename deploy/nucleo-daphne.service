[Unit]
Description=Núcleo - API y canal en vivo (daphne)
# Si falla, nucleo-aviso@ manda un correo con las últimas líneas del journal (deploy/aviso_fallo.sh).
OnFailure=nucleo-aviso@%n.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=__USUARIO__
Group=__USUARIO__
WorkingDirectory=__RAIZ__/BackEnd
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=__RAIZ__/BackEnd/.venv/bin/daphne -b 127.0.0.1 -p 8001 --proxy-headers config.asgi:application
UMask=0022
Restart=on-failure
RestartSec=5
# 1100M: deja lugar a Whisper del dictado (~340 MB de pico) y a la voz de Nico (~330 MB); los dos se
# cargan al usarse y se liberan tras 10 min sin uso.
MemoryMax=1100M

[Install]
WantedBy=multi-user.target
