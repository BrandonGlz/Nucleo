# Plantilla de BackEnd/.env para el servidor (producción ligera). Núcleo va en https://bynucleo.com
# por Cloudflare Tunnel; los ESP32 usan https://dispositivos.bynucleo.com.
# No se copia a mano: bash deploy/configurar_env.sh arma las URLs con las contraseñas del
# .env raíz, genera DJANGO_SECRET_KEY y pide la contraseña de aplicación de Gmail.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=GENERA_UNA_CLAVE_LARGA
DJANGO_DEBUG=False
# El primer origen de CORS es la URL con la que se compila la web.
DJANGO_ALLOWED_HOSTS=bynucleo.com,www.bynucleo.com,dispositivos.bynucleo.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://bynucleo.com
CSRF_TRUSTED_ORIGINS=https://bynucleo.com
# Cloudflare ya obliga HTTPS; Caddy avisa a Django con X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=3600

DATABASE_URL=postgres://nucleo_app:POSTGRES_PASSWORD@127.0.0.1:55432/nucleo_db
IOT_DATABASE_URL=postgres://nucleo_iot:IOT_PASSWORD@127.0.0.1:55433/nucleo_iot
# 0 = cada petición cierra su conexión. Daphne (ASGI) atiende en varios hilos y con conexiones
# persistentes cada hilo deja la suya abierta hasta agotar max_connections (25 en TimescaleDB).
DB_CONN_MAX_AGE=0
REDIS_URL=redis://:REDIS_PASSWORD@127.0.0.1:56379/0

DJANGO_LANGUAGE_CODE=es
DJANGO_TIME_ZONE=America/Tijuana
DJANGO_LOG_LEVEL=INFO

# Correo con Gmail (cuenta propia de Núcleo, con su contraseña de aplicación)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=nucleo.avisos@gmail.com
EMAIL_HOST_PASSWORD=CONTRASENADEAPP16
DEFAULT_FROM_EMAIL=Nucleo <nucleo.avisos@gmail.com>

# Broker MQTT local (contenedor nucleo_mosquitto)
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_USERNAME=nucleo_backend
MQTT_PASSWORD=MQTT_BACKEND_PASSWORD
MQTT_USE_TLS=True
MQTT_CA_CERT=../Mosquitto/certs/ca.crt
MQTT_TOPIC_LECTURAS=nucleo/devices/+/measurements
# Puente de Nico AI: latido y firma de peticiones del ESP.
MQTT_TOPIC_LATIDO=nucleo/devices/+/latido
MQTT_TOPIC_PUENTE_AUTORIZA=nucleo/devices/+/puente/autoriza
MQTT_TOPIC_PUENTE_PETICION=nucleo/devices/{codigo_mqtt}/puente/peticion
MQTT_PUBLICAR_CONFIG=False

# Texto de los reportes y agente: "local" redacta con plantillas a partir de las cifras, sin
# servicio externo. Vacío, los reportes responden 503.
IA_PROVEEDOR=local
# Nico AI con IA local (Ollama) por el ESP32 de cada dispositivo (ver deploy/README.md). Vacía = apagado.
IA_PUENTE_CLAVE=
IA_MODELO_LOCAL=qwen2.5:1.5b
# Ollama visto desde el backend (modo ligero del puente: el servidor ejecuta la IA).
IA_OLLAMA_URL=http://127.0.0.1:11434
IA_ESPERA_SEGUNDOS=20

NUCLEO_TOKEN_DIAS_SIN_USO=7
