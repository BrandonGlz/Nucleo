[Unit]
Description=Núcleo - procesa la cola de reportes (cifras, IA y PDF)
# Si falla, nucleo-aviso@ manda un correo con las últimas líneas del journal (deploy/aviso_fallo.sh).
OnFailure=nucleo-aviso@%n.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=__USUARIO__
Group=__USUARIO__
WorkingDirectory=__RAIZ__/BackEnd
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=__RAIZ__/BackEnd/.venv/bin/python manage.py procesar_reportes
Restart=always
RestartSec=10
MemoryMax=500M

[Install]
WantedBy=multi-user.target
